# Paste this into Streamlit Cloud: your app > Settings > Secrets.
# For testing on your computer, save it as .streamlit/secrets.toml (never commit it to GitHub).

app_password = "pick-a-household-password"
drivers = ["Justin", "Your wife's name"]

# The long ID in your sheet's URL:
# https://docs.google.com/spreadsheets/d/THIS_PART/edit
sheet_id = "PASTE_SHEET_ID_HERE"

# Receipts helper (Apps Script web app). Leave blank to hide receipt uploads.
receipts_url = "https://script.google.com/macros/s/PASTE_DEPLOYMENT_ID/exec"
receipts_token = "same-long-random-phrase-as-TOKEN-in-the-script"

# Copy each value from the service account JSON key file you download from Google Cloud.
[gcp_service_account]
type = "service_account"
project_id = ""
private_key_id = ""
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = ""
client_id = ""
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = ""
